DATABASE_URL="file:./dev.db"
# `directUrl` is required when `DATABASE_URL` points at a connection pooler
# (e.g. Prisma Accelerate). The Prisma client uses it for migrations and
# introspection. In dev, point at the same SQLite file; in production, point
# at the unpooled database URL (NOT the Accelerate URL).
DIRECT_URL="file:./dev.db"

# AES-256-GCM key used to encrypt free-text health notes at rest. Generate
# with: openssl rand -hex 32
# REQUIRED in production — without it, saving health notes fails loudly
# (never stored as plaintext). Local dev without the key falls back to base64.
HEALTH_DATA_ENCRYPTION_KEY=

# Public origin used for SEO/social metadata (absolute OG & Twitter image URLs).
# Set to your production domain when deployed (e.g. https://fibrocare.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth (NEXTAUTH_SECRET required for JWT signing; social providers optional)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Care Companion (any ONE provider key enables live AI features) ──
# Google Gemini is recommended: its free tier works in production without a
# credit card. Get a key at https://aistudio.google.com/apikey
# Without any key, the app runs in graceful offline mode (deterministic
# insight engines still power the dashboard) — OR in mock mode in local dev
# (see AI_MOCK_MODE below) so the companion stays interactive for testing.
AI_PROVIDER=google            # google | openai | anthropic (auto-detected if unset)
# AI_MODEL=gemini-3.6-flash    # optional model override (defaults per provider)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Billing webhooks (Stripe / Lemon Squeezy) ──
# Shared secrets used to verify webhook signatures. Generate with:
#   openssl rand -hex 32
# Configure the matching webhook URL: <SITE_URL>/api/webhooks/billing
# Either provider can be enabled independently (the signature header selects
# the provider). The route returns 503 until the secret is set.
STRIPE_WEBHOOK_SECRET=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ── Weather ──
# OpenWeather current-weather API. If unset, the dashboard shows
# deterministic estimated weather instead (no key required).
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=London

# Simulated AI responses — lets the AI Care Companion run interactively with
# NO provider key (ideal for local testing). true = always, false = never,
# unset = auto-ON in non-production when no key is configured.
# AI_MOCK_MODE=true

# ── Distributed rate limit + LLM cache (Upstash Redis) ─────────────
# Required for any multi-instance / horizontally-scaled deploy. When both
# values are set, the AI rate limiter and the LLM response cache route
# through Upstash so every server instance shares the same budget.
# When unset, the app uses the in-process fallback (per-instance
# Map-backed limiter) — fine for single-instance dev, unsafe for prod.
# Provision a database at https://upstash.com (free tier available, no
# credit card). Copy the REST URL and token from the dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Prisma Accelerate (connection pooling + edge query cache) ──────
# Required when `DATABASE_URL` points at a pooler (e.g. Azure connection
# pooler, AWS RDS Proxy) and the app runs in multiple regions. The
# Prisma client wraps itself with `@prisma/extension-accelerate` when
# this is set. When unset, the bare PrismaClient talks to `DATABASE_URL`
# directly — fine for single-region dev.
# Provision a project at https://console.prisma.io and copy the
# Accelerate connection string.
PRISMA_ACCELERATE_URL=

# ── Admin metrics endpoint ─────────────────────────────────────────
# Optional. When set, the route `/api/health` is reachable with the
# matching `x-admin-token` header and returns adapter names, in-process
# metrics counters, and circuit-breaker state. When unset, the route
# refuses every request (503). Generate with: openssl rand -hex 32
ADMIN_METRICS_TOKEN=
