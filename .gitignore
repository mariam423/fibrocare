# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches1
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js (any build dir — Tailwind scans non-ignored files for class candidates,
# so a stray .next-* copy with corrupted compiled CSS can poison the dev build)
.next
.next-live
.next-pwa
.next-*
out

# test/build artifacts (also scanned by Tailwind's auto source detection)
coverage/
playwright-report/
test-results/

# Playwright auth state — contains live session cookies (JWT). Never commit.
e2e/.auth/

# demo capture working directory (scripts/capture-demo.mjs)
tmp/

# generated at build time by scripts/build-sw.mjs
public/sw.js
public/workbox/

# database
*.db
*.db-journal

# logs
*.log
*.log.*

# QA screenshots and test scripts
scripts/*.png
scripts/qa_*.py
scripts/screenshot_*.py

.vercel
.env*
