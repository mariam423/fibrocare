// Postgres-flavored Prisma schema, used by `prisma migrate diff` to
// generate the initial Neon migration. The real schema is
// `schema.prisma` (provider = "sqlite") which is what `prisma
// generate` and the runtime read. This file is read only by
// `npm run db:migrate:pg`.
//
// Why a separate file instead of overriding the provider via the
// CLI: `prisma migrate diff --to-schema-datamodel` parses the file
// directly and reads the `provider =` line, so the source-of-truth
// has to be on disk. Splitting the file keeps `schema.prisma`
// SQLite-compatible for local dev (the dev path), while letting the
// deploy path emit Postgres-flavoured SQL.
//
// Every model is identical to `schema.prisma`. Keep the two in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  role                 String                @default("free_user")
  signupRole           String                @default("PATIENT")
  hydrationCount       Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  passwordHash         String?
  logs                 PainLog[]
  resetTokens          PasswordResetToken[]
  sessions             Session[]
  symptomLogs          SymptomLog[]
  doctorPosts          DoctorPost[]
  articleReactions     ArticleReaction[]
  patientConsultations Consultation[]        @relation("PatientConsultations")
  doctorConsultations  Consultation[]        @relation("DoctorConsultations")
  sentMessages         ConsultationMessage[]

  @@index([role])
  @@index([signupRole])
  @@index([createdAt])
}

model Subscription {
  id               String   @id @default(cuid())
  provider         String
  externalId       String
  plan             String
  status           String
  currentPeriodEnd String?
  updatedAt        DateTime @updatedAt

  @@unique([provider, externalId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PainLog {
  id        String   @id @default(cuid())
  painLevel Int
  moodTag   String
  notes     String?
  userId    String
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SymptomLog {
  id        String   @id @default(cuid())
  symptom   String
  date      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symptom, date])
  @@index([userId, date])
  @@index([symptom])
}

model DoctorPost {
  id             String   @id @default(cuid())
  title          String
  content        String
  tags           String   @default("")
  verifiedStatus String   @default("pending")
  source         String   @default("manual")
  language       String   @default("en")
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reactions      ArticleReaction[]

  @@index([authorId])
  @@index([verifiedStatus])
  @@index([source])
  @@index([language])
}

model ArticleReaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  kind      String
  createdAt DateTime @default(now())
  post      DoctorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, kind])
  @@index([postId, kind])
  @@index([userId])
}

model Consultation {
  id        String                @id @default(cuid())
  patientId String
  doctorId  String
  subject   String
  status    String                @default("open")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  patient   User                  @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor    User                  @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: Cascade)
  messages  ConsultationMessage[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model ConsultationMessage {
  id             String       @id @default(cuid())
  consultationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@index([senderId])
}
