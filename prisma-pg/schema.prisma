// Postgres mirror of `prisma/schema.prisma` (the canonical schema —
// provider is `postgresql` in both files since the Neon cutover). This
// file is read by `npm run db:migrate:pg` and by the CI e2e workflow
// (`npx prisma migrate deploy --schema prisma-pg/schema.prisma`), so its
// migration tree (`prisma-pg/migrations/`) must contain every migration
// in `prisma/migrations/` re-emitted for Postgres. Keep the two in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  role                 String                @default("free_user")
  signupRole           String                @default("PATIENT")
  hydrationCount       Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  passwordHash         String?
  pinHash              String?
  /// Consecutive wrong-PIN attempts since the last successful unlock.
  pinFailedAttempts    Int                   @default(0)
  /// When set and in the future, PIN entry is temporarily blocked.
  pinLockedUntil       DateTime?
  /// Latest ACR 2010/2016 self-assessment snapshot (JSON) for clinician
  /// sharing — populated by the Clinical Centre's AcrAssessment module.
  clinicalDataJson      String?
  logs                 PainLog[]
  resetTokens          PasswordResetToken[]
  sessions             Session[]
  symptomLogs          SymptomLog[]
  doctorPosts          DoctorPost[]
  articleReactions     ArticleReaction[]
  comments              Comment[]
  patientConsultations Consultation[]        @relation("PatientConsultations")
  doctorConsultations  Consultation[]        @relation("DoctorConsultations")
  sentMessages         ConsultationMessage[]
  subscriptions        Subscription[]
  cycles               MenstrualCycle[]
  menstrualLogs        MenstrualLog[]
  caregiverShareEnabled Boolean             @default(false)
  caregiverShareToken   String?             @unique
  mealLogs             MealLog[]
  triggerFoods         TriggerFood[]
  fibroFogLogs         FibroFogLog[]
  /// Daily spoon (energy) budget check-ins for the Spoon Theory widget.
  spoonLogs            SpoonLog[]

  @@index([role])
  @@index([signupRole])
  @@index([createdAt])
}

model Subscription {
  id               String   @id @default(cuid())
  provider         String
  externalId       String
  plan             String
  status           String
  currentPeriodEnd String?
  /// Owning user (null for legacy rows created before the link existed).
  userId           String?
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PainLog {
  id        String   @id @default(cuid())
  painLevel Int
  moodTag   String
  notes     String?
  userId    String
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SymptomLog {
  id        String          @id @default(cuid())
  symptom   String
  date      String
  severity  Int             @default(5)
  category  SymptomCategory @default(PHYSICAL)
  area      PainArea?
  userId    String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symptom, date])
  @@index([userId, date])
  @@index([symptom])
}

model DoctorPost {
  id             String   @id @default(cuid())
  title          String
  content        String
  tags           String   @default("")
  verifiedStatus String   @default("pending")
  /// Content kind for the Direct Doctor Publishing Hub:
  ///  - "article"  — structured patient-education articles
  ///  - "research" — research summaries / paper digests
  ///  - "status"   — short clinical status updates / personal posts
  /// Defaults to "article" (the historical behavior; pre-migration rows
  /// are all articles). Indexed for kind-filtered feeds.
  kind           String   @default("article")
  /// Origin of the post. `"ai"` rows are produced by the curated AI
  /// article generator (see `doctor-article-actions.ts`) and surface
  /// only in the `AiArticleLibrary`. `"manual"` rows are written by
  /// a verified doctor through the publishing composer and surface
  /// only in `DoctorContentFeed`. The default is `"manual"` so any
  /// pre-migration row is treated as doctor-written.
  source         String   @default("manual")
  /// Language of the post body and title. `"en"` and `"ar"` are
  /// the only values written by the AI generator; manual posts
  /// default to `"en"`. The library dedupes by `(slug, language)`,
  /// not by slug alone, so an EN post and an AR post on the same
  /// topic coexist as two cards.
  language       String   @default("en")
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrls      String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reactions      ArticleReaction[]
  comments       Comment[]

  @@index([authorId])
  @@index([verifiedStatus])
  @@index([source])
  @@index([language])
  @@index([kind])
}

model ArticleReaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  kind      String
  createdAt DateTime @default(now())
  post      DoctorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, kind])
  @@index([postId, kind])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      DoctorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model Consultation {
  id        String                @id @default(cuid())
  patientId String
  doctorId  String
  subject   String
  status    String                @default("open")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  patient   User                  @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor    User                  @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: Cascade)
  messages  ConsultationMessage[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model ConsultationMessage {
  id             String       @id @default(cuid())
  consultationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@index([senderId])
}

enum CyclePhase {
  MENSTRUAL
  FOLLICULAR
  OVULATORY
  LUTEAL
}

enum FlowIntensity {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

enum CervicalMucus {
  DRY
  STICKY
  CREAMY
  WATERY
  EGG_WHITE
}

enum OpkResult {
  NEGATIVE
  POSITIVE
  NOT_USED
}

enum SensorySensitivity {
  NONE
  MILD
  MODERATE
  SEVERE
}

enum SymptomCategory {
  PHYSICAL
  COGNITIVE
  MOOD
}

enum PainArea {
  PELVIC
  LOWER_BACK
  WIDESPREAD
  JOINTS
  OTHER
}

model MenstrualCycle {
  id              String           @id @default(cuid())
  userId          String
  startDate       DateTime
  endDate         DateTime?
  phase           CyclePhase
  overallSeverity Int              @default(5)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLogs       MenstrualLog[]

  @@index([userId, startDate])
}

model MenstrualLog {
  id                   String           @id @default(cuid())
  userId               String
  cycleId              String
  logDate              DateTime         @default(now())
  flowIntensity        FlowIntensity?
  hasClots             Boolean          @default(false)
  flowColor            String?
  crampsSeverity       Int              @default(0)
  headacheSeverity     Int              @default(0)
  breastTenderness     Int              @default(0)
  bloatingSeverity     Int              @default(0)
  giDiarrhea           Boolean          @default(false)
  giConstipation       Boolean          @default(false)
  hormonalAcne         Boolean          @default(false)
  cervicalMucus        CervicalMucus?
  opkResult            OpkResult?
  tearfulness          Int              @default(0)
  anxietyLevel         Int              @default(0)
  moodVolatility       Int              @default(0)
  energyLevel          Int              @default(5)
  libidoLevel          Int              @default(5)
  lightSensitivity     SensorySensitivity @default(NONE)
  soundSensitivity     SensorySensitivity @default(NONE)
  notes                String?
  editedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle                MenstrualCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId, logDate])
  @@index([userId, logDate])
  @@index([cycleId])
}

/// A single eating occasion (breakfast/lunch/dinner/snack) in the
/// Fibro-Dietary & Personal Flare Trigger Tracker. `warningsJson` stores a
/// snapshot of the trigger warnings shown when the meal was logged, so the
/// log history keeps showing exactly what was flagged at the time even if
/// the patient later edits their personal trigger list.
model MealLog {
  id           String     @id @default(cuid())
  userId       String
  /// UTC `YYYY-MM-DD` bucket key — the same convention as SymptomLog.date.
  date         String
  /// "breakfast" | "lunch" | "dinner" | "snack"
  mealType     String
  /// When the meal was actually eaten (drives evening/late-night windows).
  eatenAt      DateTime
  /// Pre-meal energy on the 0 (very low) – 4 (full) scale.
  energyBefore Int        @default(2)
  /// JSON snapshot of the trigger matches shown at log time.
  warningsJson String     @default("[]")
  /// Free-text notes — AES-256-GCM encrypted at rest.
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        MealItem[]

  @@index([userId, date])
  @@index([userId, eatenAt])
}

/// One food / ingredient inside a MealLog. Names stay as plain text so the
/// warning and next-day correlation engines can match them deterministically.
model MealItem {
  id     String  @id @default(cuid())
  mealId String
  name   String
  /// Optional serving note, e.g. "1 cup" or "small bowl".
  amount String?
  meal   MealLog @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([name])
}

/// The patient's own personal flare-trigger list — foods they have noticed
/// aggravate their fibromyalgia pain, fatigue, or brain fog (قائمتي
/// الشخصية للمهيجات).
model TriggerFood {
  id           String   @id @default(cuid())
  userId       String
  /// Normalized to trimmed lowercase for case-insensitive per-user uniqueness.
  name         String
  /// 1 (mild) – 5 (severe) remembered reaction intensity.
  severity     Int      @default(3)
  /// Personal reaction note — AES-256-GCM encrypted at rest.
  reactionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, severity])
}

/// One logged fibro-fog / cognitive-fatigue episode captured by the Fog
/// Shield (src/app/fog-shield). A patient reaches for this when "brain fog"
/// hits in real life — mid-task, out and about, or during a crash — and
/// logs the episode + the coping tool they used, so progress and triggers
/// become visible over time.
///
/// `triggers` stores a snapshot of the situational categories selected at
/// log time (e.g. "LOW_SLEEP", "STRESS", "LONG_SCREEN_TIME", "NOISE",
/// "LOW_FOOD", "MENSTRUAL"). `brainDumpText` is free text the patient used
/// to offload racing/chaotic thoughts — AES-256-GCM encrypted at rest by the
/// server action. `copingToolUsed` records which Fog Shield module they
/// reached for (BREATH | DUMP | MICROTASK | SOS | NONE).
model FibroFogLog {
  id             String   @id @default(cuid())
  userId         String
  /// Self-reported fog intensity: 1 (mild haze) – 10 (overwhelmed).
  intensity      Int      @default(5)
  /// Situational trigger labels for this episode (snapshot at log time).
  triggers       String[] @default([])
  /// Free-form brain dump — encrypted at rest, never stored plaintext.
  brainDumpText  String?
  /// The grounding tool the user reached for during the episode.
  copingToolUsed String   @default("NONE")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "What did my fog look like this week?" history reads.
  @@index([userId, createdAt])
}

/// Daily spoon (energy) budget check-in for the Spoon Theory widget.
/// One row per user per calendar day (unique on (userId, logDate)); the
/// morning check-in upserts it. `startSpoons` is the user's subjective
/// 1–10 capacity, `currentSpoons` drifts with rest/activity presets.
model SpoonLog {
  id            String   @id @default(cuid())
  userId        String
  /// Calendar day this check-in belongs to (ISO yyyy-mm-dd, UTC).
  logDate       String
  /// Subjective morning capacity, 1–10.
  startSpoons   Int
  /// Live balance as the day is spent/rested. Never below 0.
  currentSpoons Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One check-in per day — the morning prompt upserts.
  @@unique([userId, logDate])
  @@index([userId, logDate])
}
