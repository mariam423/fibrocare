generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // `env()` lets Vercel/any host point this at a real database via
  // DATABASE_URL (e.g. Vercel Postgres). Local dev keeps the SQLite file via
  // DATABASE_URL="file:./dev.db" in .env — see .env.example.
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  hydrationCount Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  passwordHash   String?
  logs           PainLog[]
  resetTokens    PasswordResetToken[]
  sessions       Session[]
  symptomLogs    SymptomLog[]
}

/// Provider-agnostic billing state written by the webhook route
/// (src/app/api/webhooks/billing/route.ts). One row per provider+external
/// subscription id; upserted on every activation / deactivation event.
model Subscription {
  id               String   @id @default(cuid())
  provider         String
  externalId       String
  plan             String
  status           String
  currentPeriodEnd String?
  updatedAt        DateTime @updatedAt

  @@unique([provider, externalId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PainLog {
  id        String   @id @default(cuid())
  painLevel Int
  moodTag   String
  notes     String?
  userId    String
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SymptomLog {
  id        String   @id @default(cuid())
  symptom   String
  date      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symptom, date])
  @@index([userId, date])
  @@index([symptom])
}
