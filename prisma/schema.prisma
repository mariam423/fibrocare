generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // `env()` lets Vercel/any host point this at a real database via
  // DATABASE_URL (e.g. Vercel Postgres). Local dev keeps the SQLite file via
  // DATABASE_URL="file:./dev.db" in .env — see .env.example.
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  role                 String                @default("free_user")
  signupRole           String                @default("PATIENT")
  hydrationCount       Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  passwordHash         String?
  logs                 PainLog[]
  resetTokens          PasswordResetToken[]
  sessions             Session[]
  symptomLogs          SymptomLog[]
  doctorPosts          DoctorPost[]
  articleReactions     ArticleReaction[]
  patientConsultations Consultation[]        @relation("PatientConsultations")
  doctorConsultations  Consultation[]        @relation("DoctorConsultations")
  sentMessages         ConsultationMessage[]
}

/// Provider-agnostic billing state written by the webhook route
/// (src/app/api/webhooks/billing/route.ts). One row per provider+external
/// subscription id; upserted on every activation / deactivation event.
model Subscription {
  id               String   @id @default(cuid())
  provider         String
  externalId       String
  plan             String
  status           String
  currentPeriodEnd String?
  updatedAt        DateTime @updatedAt

  @@unique([provider, externalId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PainLog {
  id        String   @id @default(cuid())
  painLevel Int
  moodTag   String
  notes     String?
  userId    String
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SymptomLog {
  id        String   @id @default(cuid())
  symptom   String
  date      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symptom, date])
  @@index([userId, date])
  @@index([symptom])
}

model DoctorPost {
  id             String   @id @default(cuid())
  title          String
  content        String
  tags           String   @default("")
  verifiedStatus String   @default("pending")
  /// Origin of the post. `"ai"` rows are produced by the curated AI
  /// article generator (see `doctor-article-actions.ts`) and surface
  /// only in the `AiArticleLibrary`. `"manual"` rows are written by
  /// a verified doctor through the publishing composer and surface
  /// only in `DoctorContentFeed`. The default is `"manual"` so any
  /// pre-migration row is treated as doctor-written.
  source         String   @default("manual")
  /// Language of the post body and title. `"en"` and `"ar"` are
  /// the only values written by the AI generator; manual posts
  /// default to `"en"`. The library dedupes by `(slug, language)`,
  /// not by slug alone, so an EN post and an AR post on the same
  /// topic coexist as two cards.
  language       String   @default("en")
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reactions      ArticleReaction[]

  @@index([authorId])
  @@index([verifiedStatus])
  @@index([source])
  @@index([language])
}

/// Per-user reaction on a verified Doctor Hub article.
///
/// `kind` is `"like"` or `"helpful"`. A user can hold both kinds on
/// the same post (stored as two rows) and the like/helpful count is
/// the row count. We keep a row-per-reaction model (instead of a
/// counter column on DoctorPost) so the same user cannot inflate the
/// count by repeatedly toggling — the (userId, postId, kind)
/// uniqueness is the only thing that matters.
model ArticleReaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  /// "like" or "helpful"
  kind      String
  createdAt DateTime @default(now())
  post      DoctorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, kind])
  @@index([postId, kind])
}

model Consultation {
  id        String                @id @default(cuid())
  patientId String
  doctorId  String
  subject   String
  status    String                @default("open")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  patient   User                  @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor    User                  @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: Cascade)
  messages  ConsultationMessage[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model ConsultationMessage {
  id             String       @id @default(cuid())
  consultationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([senderId])
}
