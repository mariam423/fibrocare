generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  hydrationCount Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  passwordHash   String?
  logs           PainLog[]
  resetTokens    PasswordResetToken[]
  sessions       Session[]
  symptomLogs    SymptomLog[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PainLog {
  id        String   @id @default(cuid())
  painLevel Int
  moodTag   String
  notes     String?
  userId    String
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SymptomLog {
  id        String   @id @default(cuid())
  symptom   String
  date      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symptom, date])
  @@index([userId, date])
  @@index([symptom])
}
