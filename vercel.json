{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",

  "regions": ["iad1"],

  "functions": {
    "src/app/api/weather/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/chat/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/ai/insight/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/ai/reflect/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/ai/care-plan/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/ai/clinical-brief/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/ai/questions/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/ai/parse-log/route.ts": {
      "maxDuration": 45
    }
  },

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/health-logs",
      "destination": "/dashboard",
      "permanent": false
    }
  ]
}
